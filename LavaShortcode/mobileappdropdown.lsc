{
  "Guid": "44b92a24-d6aa-4b0e-8682-b98f9bda7b36",
  "Name": "BEMA | Mobile App Dropdown",
  "EnabledLavaCommands": "",
  "TagName": "mobileappdropdown",
  "TagType": 1,
  "Description": "Creates a dropdown item for the mobile app. Takes parameters of height, title, and content.",
  "Documentation": "<p>{[ mobileappdropdown height:'160' title:'Why be baptized?' content:'Baptism is an act of obedience, symbolizing cleansing, new life, and incorporation into the body of Christ. It allows believers to identify with Jesus' death and resurrection, affirm their commitment to follow Him, and express their hope in eternal life.' ]}</p>",
  "Markup": "{%- assign uniqueId = uniqueId | UniqueIdentifier -%}\n\n<Grid RowDefinitions=\"auto,*\">\n    <Border StyleClass=\"p-16\"\n            StrokeShape=\"RoundRectangle 0,0,22,22\"\n            Margin=\"0,-10,0,0\"\n            Background=\"#143F69\"\n            x:Name=\"expanderInner{{ uniqueId }}\"\n            Grid.Row=\"1\"\n            IsVisible=\"False\"\n            Opacity=\"0\">\n        <StackLayout StyleClass=\"px-8,py-16\">\n            <Label x:Name=\"expanderContent{{ uniqueId }}\"\n                   LineHeight=\"1\"\n                   Text=\"{{ content | Escape }}\"\n                   TextColor=\"#FFFFFF\"\n                   HorizontalOptions=\"Center\"\n                   HorizontalTextAlignment=\"Center\" />\n        </StackLayout>\n    </Border>\n    <!-- open / close expander -->\n    <Border StyleClass=\"px-8\"\n            Background=\"#FFFFFF\"\n            StrokeShape=\"RoundRectangle 22,22,22,22\"\n            Grid.Row=\"0\"\n            HeightRequest=\"50\">\n        <Grid>\n            <Label StyleClass=\"text-black, font-weight-bold\"\n                   Text=\"{{ title | Escape }}\"\n                   FontSize=\"18\"\n                   VerticalOptions=\"Center\"\n                   HorizontalOptions=\"Center\"\n                   HorizontalTextAlignment=\"Center\"\n                   LineBreakMode=\"WordWrap\" />\n            <Grid>\n                <Button StyleClass=\"btn\" BackgroundColor=\"Transparent\" WidthRequest=\"300\" VerticalOptions=\"Center\" HorizontalOptions=\"Start\" Command=\"{Binding AggregateCommand}\" x:Name=\"hideBtn{{ uniqueId }}\">\n                    <Button.CommandParameter>\n                        <Rock:AggregateCommandParameters>\n                            <Rock:CommandReference Command=\"{Binding SetViewProperty}\">\n                                <Rock:SetViewPropertyParameters View=\"{x:Reference showBtn{{ uniqueId }}}\"\n                                    Name=\"IsVisible\"\n                                    Value=\"True\" />\n                            </Rock:CommandReference>\n                            <Rock:CommandReference Command=\"{Binding SetViewProperty}\">\n                                <Rock:SetViewPropertyParameters View=\"{x:Reference hideBtn{{ uniqueId }}}\"\n                                    Name=\"IsVisible\"\n                                    Value=\"False\" />\n                            </Rock:CommandReference>\n                            <Rock:CommandReference Command=\"{Binding SetViewProperty}\">\n                                <Rock:SetViewPropertyParameters View=\"{x:Reference expanderInner{{ uniqueId }}}\"\n                                    Name=\"IsVisible\"\n                                    Value=\"False\" />\n                            </Rock:CommandReference>\n                            <Rock:CommandReference Command=\"{Binding SetViewProperty}\">\n                                <Rock:SetViewPropertyParameters View=\"{x:Reference expanderInner{{ uniqueId }}}\"\n                                    Name=\"Opacity\"\n                                    Value=\"0\" />\n                            </Rock:CommandReference>\n                        </Rock:AggregateCommandParameters>\n                    </Button.CommandParameter>\n                </Button>\n                <Button StyleClass=\"btn\" BackgroundColor=\"Transparent\" WidthRequest=\"300\" VerticalOptions=\"Center\" HorizontalOptions=\"Start\" Command=\"{Binding AggregateCommand}\" x:Name=\"showBtn{{uniqueId}}\">\n                    <Button.CommandParameter>\n                        <Rock:AggregateCommandParameters>\n                            <Rock:CommandReference Command=\"{Binding SetViewProperty}\">\n                                <Rock:SetViewPropertyParameters View=\"{x:Reference showBtn{{ uniqueId }}}\"\n                                    Name=\"IsVisible\"\n                                    Value=\"False\" />\n                            </Rock:CommandReference>\n                            <Rock:CommandReference Command=\"{Binding SetViewProperty}\">\n                                <Rock:SetViewPropertyParameters View=\"{x:Reference hideBtn{{ uniqueId }}}\"\n                                    Name=\"IsVisible\"\n                                    Value=\"True\" />\n                            </Rock:CommandReference>\n                            <Rock:CommandReference Command=\"{Binding SetViewProperty}\">\n                                <Rock:SetViewPropertyParameters View=\"{x:Reference expanderInner{{ uniqueId }}}\"\n                                    Name=\"IsVisible\"\n                                    Value=\"True\" />\n                            </Rock:CommandReference>\n                            <Rock:CommandReference Command=\"{Binding SetViewProperty}\">\n                                <Rock:SetViewPropertyParameters View=\"{x:Reference expanderInner{{ uniqueId }}}\"\n                                    Name=\"Opacity\"\n                                    Value=\"1\" />\n                            </Rock:CommandReference>\n                            <Rock:CommandReference Command=\"{Binding ScrollToVisible}\">\n                                <Rock:ScrollToVisibleParameters Anchor=\"{x:Reference expanderInner{{ uniqueId }}}\" Position=\"Center\" />\n                            </Rock:CommandReference>\n                        </Rock:AggregateCommandParameters>\n                    </Button.CommandParameter>\n                </Button>\n\n            </Grid>\n        </Grid>\n    </Border>\n</Grid>\n"
}