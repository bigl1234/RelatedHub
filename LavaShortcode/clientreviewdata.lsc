{
  "Guid": "cf95b23d-2c6f-410c-bd5a-250515a910dc",
  "Name": "Client Review Data",
  "EnabledLavaCommands": "Sql",
  "TagName": "clientreviewdata",
  "TagType": 1,
  "Description": "Returns the client review data for a developer. \n{[ clientreviewdata personid:'123' ]}",
  "Documentation": "<p>Returns the client review data for a developer. \n</p><p>{[ clientreviewdata personid:'123' ]}</p>",
  "Markup": "{% sql return:'feedback' %}\n\nDECLARE @ClientFeedbackHistoryCategoryId INT = 333\nDECLARE @PersonId INT = {{personid}}\n\nDECLARE @DateRange NVARCHAR(MAX) = '{{daterange | SanitizeSql}}'\nDECLARE @StartDate DATETIME2\nDECLARE @EndDate DATETIME2\n\nSELECT @StartDate = a.value\nFROM STRING_SPLIT(@DateRange, ',', 1) a\nWHERE LEN(a.value) > 0 AND a.ordinal = 1\n\nSELECT @EndDate = a.value\nFROM STRING_SPLIT(@DateRange, ',', 1) a\nWHERE LEN(a.value) > 0 AND a.ordinal = 2\n\nSELECT \n\tdev.Id\n\t, dev.NickName\n\t, dev.LastName\n\t, h.ModifiedDateTime\n\t, Date = TRY_CAST(JSON_VALUE(h.RelatedData, '$.Date') AS DATE)\n\t, Rating = JSON_VALUE(h.RelatedData, '$.Rating')\n\t, AdditionalFeedback = JSON_VALUE(h.RelatedData, '$.AdditionalFeedback')\n\t, Shortcomings = JSON_VALUE(h.RelatedData, '$.Shortcomings')\n\t, PodLeader = JSON_VALUE(h.RelatedData, '$.PodLeader')\n\t, PodLeaderPersonId = TRY_CAST(JSON_VALUE(h.RelatedData, '$.PodLeaderPersonId') AS INT)\n\t, Developer = JSON_VALUE(h.RelatedData, '$.Developer')\n\t, DeveloperPersonId = TRY_CAST(JSON_VALUE(h.RelatedData, '$.DeveloperPersonId') AS INT)\n\t, Client = JSON_VALUE(h.RelatedData, '$.Client')\n\t, ClientId = TRY_CAST(JSON_VALUE(h.RelatedData, '$.ClientId') AS INT)\n\t, WorkflowJSON = JSON_VALUE(h.RelatedData, '$.WorkflowJSON')\n\t, AttributeValuesJSON = h.OldValue\nFROM History h\nJOIN Person dev ON dev.Id = h.EntityId\nLEFT JOIN Person podl ON podl.Id = h.RelatedEntityId\nWHERE \n    h.CategoryId = @ClientFeedbackHistoryCategoryId\n    AND h.EntityId = @PersonId \n\tAND ISNULL(h.CreatedDateTime, '1900-01-01') BETWEEN ISNULL(@StartDate, '1900-01-01') AND ISNULL(@EndDate, '2999-01-01')\n{% endsql %}\n\n\n{% assign results = '' %}\n\n{% for workflow in feedback %}\n    {% assign attributevaluesobj = workflow.AttributeValuesJSON | FromJSON %}\n    {% assign workflowobj = workflow.WorkflowJSON | FromJSON %}\n    {% assign workflowobj = workflowobj | AddToDictionary:'AttributeValues',attributevaluesobj %}\n    {% assign newobj = workflow | ToJSON | FromJSON | RemoveFromDictionary:'WorkflowJSON' %}\n    {% assign newobj = newobj | RemoveFromDictionary:'AttributeValuesJSON' %}\n    {% assign newobj = newobj | AddToDictionary:'Workflow',workflowobj %}\n    {% assign results = results | AddToArray:newobj %}\n\n{% endfor %}\n\n{{results | ToJSON}}"
}