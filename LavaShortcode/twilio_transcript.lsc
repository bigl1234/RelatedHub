{
  "Guid": "66aadbff-3161-4bf7-baf4-bc08638ac29c",
  "Name": "Twilio Session",
  "EnabledLavaCommands": "RockEntity",
  "TagName": "twilio_transcript",
  "TagType": 1,
  "Description": "A small shortcode that displays any twilio chat interactions matching the foreign id passed in",
  "Documentation": "<font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">{% assign foreignKeyArray = foreignkey | Split:':' %}</span></font><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">{% assign foreignKeyArraySize = foreignKeyArray | Size %}</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">{% if foreignKeyArraySize == 2 and foreignKeyArray[0] == 'Chatbot' %}</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">&nbsp; &nbsp; &lt;div class=\"alert alert-info\"&gt;</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">&nbsp; &nbsp; &nbsp; &nbsp; &lt;h2&gt;Chat Transcript&lt;/h2&gt;</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">&nbsp; &nbsp; &nbsp; &nbsp; &lt;ul&gt;</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; {% interaction where:'InteractionSummary == \"{{foreignKeyArray[1]}}\"' sort:'CreatedDateTime desc' securityenabled:'false'%}</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; {% for interactionDetail in interactionItems %}</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;li&gt;&lt;b&gt;{{interactionDetail.Operation}} ({{interactionDetail.CreatedDateTime}}):&lt;/b&gt; {{interactionDetail.InteractionData}}&lt;/li&gt;</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; {% endfor %}</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; {% endinteraction%}</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">&nbsp; &nbsp; &nbsp; &nbsp; &lt;/ul&gt;</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">&nbsp; &nbsp; &lt;/div&gt;</span></font></div><div><font color=\"#e83e8c\" face=\"Menlo, Monaco, Consolas, Courier New, monospace\"><span style=\"font-size: 14.4px;\">{% endif %}</span></font></div>",
  "Markup": "{% assign foreignKeyArray = foreignkey | Split:':' %}\n{% assign foreignKeyArraySize = foreignKeyArray | Size %}\n{% if foreignKeyArraySize == 2 and foreignKeyArray[0] == 'Chatbot' %}\n    <div class=\"alert alert-info\">\n        <h2>Chat Transcript</h2>\n        <ul>\n            {% interaction where:'InteractionSummary == \"{{foreignKeyArray[1]}}\"' sort:'CreatedDateTime desc' securityenabled:'false'%}\n                {% for interactionDetail in interactionItems %}\n                    <li><b>{{interactionDetail.Operation}} ({{interactionDetail.CreatedDateTime}}):</b> {{interactionDetail.InteractionData}}</li>\n                {% endfor %}\n            {% endinteraction%}\n        </ul>\n    </div>\n{% endif %}"
}